# 复制为项目根目录 .env 并填入真实值（.env 已加入 .gitignore，勿提交）
# 本地：cp .env.example .env
# 服务器：在 /opt/zdmj/zdmj/.env 维护同一份变量

# ---------- 基础设施（Docker Compose postgres / redis）----------
PG_USER=zdmj
PG_PASSWORD=change-me
PG_DB=zdmj
REDIS_PASSWORD=change-me

# 远程主机 IP（本地直连宿主机 postgres/redis；生产/远程开发填服务器 IP）
APP_REMOTE_HOST=127.0.0.1

# ---------- 后端 Spring（Compose 会映射为 SPRING_*）----------
# Docker 内数据库 URL（host 必须为 postgres）
DATASOURCE_URL=jdbc:postgresql://postgres:5432/zdmj?currentSchema=public&stringtype=unspecified&TimeZone=Asia/Shanghai&sslmode=disable

DASHSCOPE_API_KEY=your-dashscope-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
AL_MODEL=qwen3.6-plus

COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_REGION=ap-shanghai
COS_BUCKET=your-cos-bucket-name

MAIL_USERNAME=your-mail@example.com
MAIL_PASSWORD=your-mail-password

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 用户 LLM API Key 落库加密主密钥（生产务必配置；开发可留空走兜底）
# 用户 LLM API Key 加密密钥（Spring Encryptors.text，须为偶数位 hex，如 openssl rand -hex 16）
APP_AI_USER_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef