{
  "module": "com.zdmj.jobService",
  "publicMethods": [
    {
      "className": "JobServiceImpl",
      "method": "getDetail(Long)",
      "givenWhenThen": {
        "given": [
          "redis 可能命中空值标记",
          "redis 可能命中 DTO",
          "缓存未命中时 DB 可能为空或有数据"
        ],
        "when": "根据岗位 id 查询详情",
        "then": [
          "空值标记命中时抛 BusinessException: JOB_NOT_FOUND(10001)",
          "DB 为空时写入空值缓存并抛 JOB_NOT_FOUND(10001)",
          "DB 命中时写缓存并返回 DTO"
        ]
      },
      "paths": [
        {
          "pathId": "JOB_GET_DETAIL_NULL_MARKER",
          "type": "negative",
          "description": "缓存空值标记命中，抛岗位不存在"
        },
        {
          "pathId": "JOB_GET_DETAIL_DB_MISS",
          "type": "negative",
          "description": "缓存未命中且 DB 无记录，写空值并抛岗位不存在"
        },
        {
          "pathId": "JOB_GET_DETAIL_CACHE_HIT",
          "type": "happy",
          "description": "缓存命中直接返回"
        }
      ],
      "assertionContract": [
        {
          "field": "BusinessException.errorCode",
          "expected": "10001",
          "reason": "岗位不存在语义必须稳定"
        },
        {
          "field": "redisCacheUtil.setNullValue",
          "expected": "DB miss 时被调用",
          "reason": "避免缓存穿透"
        }
      ]
    },
    {
      "className": "JobServiceImpl",
      "method": "update(JobRequest)",
      "givenWhenThen": {
        "given": [
          "岗位可能不存在",
          "岗位存在时需要清理详情缓存"
        ],
        "when": "按 DTO 更新岗位",
        "then": [
          "岗位不存在抛 BusinessException: JOB_NOT_FOUND(10001)",
          "更新成功后清理 normal/null 两类缓存键"
        ]
      },
      "paths": [
        {
          "pathId": "JOB_UPDATE_NOT_FOUND",
          "type": "negative",
          "description": "DB 无岗位，抛岗位不存在"
        },
        {
          "pathId": "JOB_UPDATE_SUCCESS",
          "type": "happy",
          "description": "更新成功并清理缓存"
        }
      ],
      "assertionContract": [
        {
          "field": "redisCacheUtil.delete",
          "expected": "至少被调用 2 次",
          "reason": "normal/null 标记都应清理"
        }
      ]
    },
    {
      "className": "JobServiceImpl",
      "method": "delete(Long)",
      "givenWhenThen": {
        "given": [
          "removeById 可能返回 false",
          "删除成功需要清理缓存"
        ],
        "when": "删除岗位",
        "then": [
          "removeById=false 抛 BusinessException: JOB_NOT_FOUND(10001)",
          "删除成功后清理 normal/null 缓存"
        ]
      },
      "paths": [
        {
          "pathId": "JOB_DELETE_NOT_FOUND",
          "type": "negative",
          "description": "删除不存在岗位抛 10001"
        },
        {
          "pathId": "JOB_DELETE_SUCCESS",
          "type": "happy",
          "description": "删除成功并清理缓存"
        }
      ],
      "assertionContract": [
        {
          "field": "BusinessException.errorCode",
          "expected": "10001",
          "reason": "错误码一致性"
        }
      ]
    },
    {
      "className": "JobCapabilityProfileServiceImpl",
      "method": "getJobCapabilityProfile(Long)",
      "givenWhenThen": {
        "given": [
          "chatUtil 结构化生成可能抛异常",
          "existing profile 可能存在"
        ],
        "when": "生成岗位能力画像",
        "then": [
          "LLM 失败抛 BusinessException: JOB_CAPABILITY_PROFILE_GENERATION_FAILED(10002)",
          "成功时执行 upsert 并返回 DTO"
        ]
      },
      "paths": [
        {
          "pathId": "JOB_PROFILE_GENERATE_FAIL",
          "type": "negative",
          "description": "chatStructuredOnce 异常映射为 10002"
        },
        {
          "pathId": "JOB_PROFILE_UPSERT_UPDATE",
          "type": "happy",
          "description": "existing 存在走更新"
        }
      ],
      "assertionContract": [
        {
          "field": "BusinessException.errorCode",
          "expected": "10002",
          "reason": "能力画像失败语义"
        }
      ]
    },
    {
      "className": "JobCareerGraphServiceImpl",
      "method": "generate(Long)",
      "givenWhenThen": {
        "given": [
          "chatUtil 可能抛异常",
          "生成图谱可能不满足 3/5/2 规则"
        ],
        "when": "生成岗位路径图谱",
        "then": [
          "LLM 失败抛 BusinessException: JOB_CAREER_GRAPH_GENERATION_FAILED(10004)",
          "非法图谱抛 BusinessException: JOB_CAREER_GRAPH_INVALID(10005)",
          "合法图谱标记 currentNode 后持久化"
        ]
      },
      "paths": [
        {
          "pathId": "JOB_GRAPH_GENERATE_FAIL",
          "type": "negative",
          "description": "chat 异常映射为 10004"
        },
        {
          "pathId": "JOB_GRAPH_VALIDATE_FAIL",
          "type": "negative",
          "description": "图谱不合规映射为 10005"
        },
        {
          "pathId": "JOB_GRAPH_GENERATE_SUCCESS",
          "type": "happy",
          "description": "图谱合法并保存"
        }
      ],
      "assertionContract": [
        {
          "field": "BusinessException.errorCode",
          "expected": "10004/10005",
          "reason": "生成失败与结构不合法需区分"
        }
      ]
    },
    {
      "className": "JobAnalysisSupport",
      "method": "detectRole(String, ChatUtil, Map, int, Logger)",
      "givenWhenThen": {
        "given": [
          "文本可能为空",
          "关键词可能达到阈值",
          "LLM 调用可能异常"
        ],
        "when": "识别岗位角色",
        "then": [
          "空文本返回 UNKNOWN",
          "阈值命中直接返回最佳角色",
          "LLM 异常回退关键词最佳角色"
        ]
      },
      "paths": [
        {
          "pathId": "JOB_ROLE_EMPTY_TEXT",
          "type": "boundary",
          "description": "空文本边界返回 UNKNOWN"
        },
        {
          "pathId": "JOB_ROLE_LLM_FALLBACK",
          "type": "negative",
          "description": "LLM 抛异常回退关键词角色"
        }
      ],
      "assertionContract": [
        {
          "field": "return role",
          "expected": "UNKNOWN 或关键词最佳角色",
          "reason": "角色判定逻辑正确性"
        }
      ]
