{
  "module": "backend/zdmj/src/main/java/com/zdmj/jobService",
  "publicMethods": [
    {
      "className": "com.zdmj.jobService.service.impl.JobServiceImpl",
      "method": "getDetail(Long id)",
      "givenWhenThen": {
        "given": [
          "输入岗位ID",
          "Redis缓存可能存在命中、空值标记或未命中",
          "数据库可能存在或不存在该岗位详情"
        ],
        "when": "调用 getDetail",
        "then": [
          "缓存命中时直接返回缓存DTO",
          "缓存未命中且数据库存在时写入缓存并返回DTO",
          "缓存空值标记或数据库不存在时抛出BusinessException(ErrorCode.JOB_NOT_FOUND)"
        ]
      },
      "paths": [
        {
          "pathId": "JOB-GETDETAIL-HAPPY-CACHE-HIT",
          "type": "happy",
          "description": "缓存中存在岗位详情对象，直接返回，不访问数据库"
        },
        {
          "pathId": "JOB-GETDETAIL-HAPPY-DB-HIT",
          "type": "happy",
          "description": "缓存未命中、数据库命中，写入缓存并返回DTO"
        },
        {
          "pathId": "JOB-GETDETAIL-NEG-CACHE-NULL",
          "type": "negative",
          "description": "命中缓存空值标记，抛出JOB_NOT_FOUND"
        },
        {
          "pathId": "JOB-GETDETAIL-NEG-DB-MISS",
          "type": "negative",
          "description": "缓存未命中且数据库不存在，写入空值标记并抛出JOB_NOT_FOUND"
        }
      ],
      "assertionContract": [
        {
          "field": "exception.code",
          "expected": "10001",
          "reason": "BusinessException(ErrorCode.JOB_NOT_FOUND)必须映射岗位不存在语义"
        },
        {
          "field": "cache.writeTTL",
          "expected": "命中DB后写入JOB_DETAIL_TTL",
          "reason": "验证缓存回填策略"
        },
        {
          "field": "cache.nullMarker",
          "expected": "DB不存在时写入JOB_DETAIL_NULL_TTL",
          "reason": "验证缓存穿透防护策略"
        }
      ]
    },
    {
