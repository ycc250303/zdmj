          "筛选字段可能为空集合或带空白字符"
        ],
        "when": "调用 getPage",
        "then": [
          "query为null时使用默认分页(page=1,limit=20)",
          "limit超过100时被截断为100",
          "空集合筛选条件转为null、字符串筛选去首尾空格",
          "返回PageDTO并兜底total为0"
        ]
      },
      "paths": [
        {
          "pathId": "JOB-GETPAGE-HAPPY-NORMAL",
          "type": "happy",
          "description": "传入有效分页和筛选条件，返回正常分页数据"
        },
        {
          "pathId": "JOB-GETPAGE-BOUND-NULL-QUERY",
          "type": "boundary",
          "description": "query为空，使用默认分页并正常返回"
        },
        {
          "pathId": "JOB-GETPAGE-BOUND-LIMIT-CAP",
          "type": "boundary",
          "description": "limit大于100时被截断到100"
        },
        {
          "pathId": "JOB-GETPAGE-NEG-INVALID-PAGE-LIMIT",
          "type": "negative",
          "description": "page/limit小于1时回退默认值，不抛异常"
        }
      ],
      "assertionContract": [
        {
          "field": "result.page",
          "expected": "非法页码时回退为1",
          "reason": "保证分页入参健壮性"
        },
        {
          "field": "result.limit",
          "expected": "非法limit回退20，超限截断100",
          "reason": "保证最大页大小约束"
        },
        {
          "field": "mapper.queryArgs",
          "expected": "空集合筛选被归一为null，字符串去空白",
          "reason": "保证SQL筛选一致性"
        }
      ]
    },
