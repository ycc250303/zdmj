<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zdmj.jobService.mapper.JobMapper">

    <sql id="Job_Salary_Label_Expr">
        (CASE j.salary_type
            WHEN 1 THEN (j.salary_min::text || '-' || j.salary_max::text || '元/日')
            WHEN 3 THEN (j.salary_min::text || '-' || j.salary_max::text || '元/年')
            ELSE (j.salary_min::text || '-' || j.salary_max::text || '元/月')
        END)
    </sql>

    <resultMap id="JobDetailDTOMap" type="com.zdmj.jobService.dto.JobListItemResponse">
        <id property="id" column="id" />
        <result property="jobName" column="job_name" />
        <result property="companyId" column="company_id" />
        <result property="companyName" column="company_name" />
        <result property="description" column="description" />
        <result property="location" column="location" />
        <result property="salaryMin" column="salary_min" />
        <result property="salaryMax" column="salary_max" />
        <result property="salaryType" column="salary_type" />
        <result property="salary" column="salary" />
        <result property="link" column="link" />
        <result property="jobDuties" column="job_duties"
            typeHandler="com.zdmj.common.typehandler.JsonbListTypeHandler" />
        <result property="jobRequirements" column="job_requirements"
            typeHandler="com.zdmj.common.typehandler.JsonbListTypeHandler" />
        <result property="keywords" column="job_keywords"
            typeHandler="com.zdmj.common.typehandler.JsonbListTypeHandler" />
        <result property="companyIndustries" column="company_industries"
            typeHandler="com.zdmj.common.typehandler.JsonbListTypeHandler" />
        <result property="companySize" column="company_size" />
        <result property="companyFundingType" column="company_funding_type" />
    </resultMap>

    <resultMap id="JobListItemResponseMap" type="com.zdmj.jobService.dto.JobListItemResponse">
        <id property="id" column="id" />
        <result property="jobName" column="job_name" />
        <result property="companyId" column="company_id" />
        <result property="companyName" column="company_name" />
        <result property="description" column="description" />
        <result property="location" column="location" />
        <result property="salaryMin" column="salary_min" />
        <result property="salaryMax" column="salary_max" />
        <result property="salaryType" column="salary_type" />
        <result property="salary" column="salary" />
        <result property="link" column="link" />
        <result property="jobDuties" column="job_duties"
            typeHandler="com.zdmj.common.typehandler.JsonbListTypeHandler" />
        <result property="jobRequirements" column="job_requirements"
            typeHandler="com.zdmj.common.typehandler.JsonbListTypeHandler" />
        <result property="keywords" column="job_keywords"
            typeHandler="com.zdmj.common.typehandler.JsonbListTypeHandler" />
        <result property="companyIndustries" column="company_industries"
            typeHandler="com.zdmj.common.typehandler.JsonbListTypeHandler" />
        <result property="companySize" column="company_size" />
        <result property="companyFundingType" column="company_funding_type" />
    </resultMap>

    <sql id="Job_Company_From_Where"> FROM jobs j INNER JOIN companies c ON j.company_id = c.id
        WHERE 1 = 1
        <if test="q.companySizes != null and q.companySizes.size() &gt; 0"> AND c.size IN <foreach
                collection="q.companySizes" item="s" open="(" separator="," close=")">#{s}</foreach>
        </if>
        <if test="q.fundingTypes != null and q.fundingTypes.size() &gt; 0"> AND c.type IN <foreach
                collection="q.fundingTypes" item="t" open="(" separator="," close=")">#{t}</foreach>
        </if>
        <if test="q.industries != null and q.industries.size() &gt; 0"> AND ( <foreach
                collection="q.industries" item="ind" separator=" OR "> (c.industries IS NOT NULL AND
        c.industries::jsonb @> jsonb_build_array(CAST(#{ind} AS TEXT))) </foreach> ) </if>
        <if test="q.companyName != null and q.companyName != ''"> AND (j.company_name LIKE '%' || CAST(#{q.companyName} AS TEXT) || '%' OR c.name LIKE '%' || CAST(#{q.companyName} AS TEXT) || '%') </if>
        <if test="q.fullTimeEmployment != null and q.fullTimeEmployment"> AND j.salary_type IN (2, 3) </if>
        <if test="q.resolvedSalaryType != null and (q.fullTimeEmployment == null or !q.fullTimeEmployment)"> AND j.salary_type = #{q.resolvedSalaryType} </if>
        <if test="q.filterSalaryMin != null and (q.fullTimeEmployment != null or q.resolvedSalaryType != null)"> AND j.salary_min &gt;= #{q.filterSalaryMin} </if>
        <if test="q.filterSalaryMax != null and (q.fullTimeEmployment != null or q.resolvedSalaryType != null)"> AND j.salary_max &lt;= #{q.filterSalaryMax} </if>
        <if test="q.jobName != null and q.jobName != ''"> AND j.job_name LIKE '%' || CAST(#{q.jobName} AS TEXT) || '%' </if>
    </sql>

    <select id="selectDetailById" resultMap="JobDetailDTOMap">
        SELECT j.id, j.job_name, j.company_id, j.company_name, j.description, j.location,
            j.salary_min, j.salary_max, j.salary_type,
            <include refid="Job_Salary_Label_Expr" /> AS salary,
            j.link,
            j.content AS job_duties,
            j.requirements AS job_requirements,
            j.keywords AS job_keywords,
            c.industries AS company_industries,
            c.size AS company_size, c.type AS company_funding_type
        FROM jobs j INNER JOIN companies c ON j.company_id = c.id
        WHERE j.id = #{id}
    </select>

    <select id="selectJobPage" resultMap="JobListItemResponseMap">
        SELECT j.id, j.job_name, j.company_id, j.company_name, j.description, j.location,
            j.salary_min, j.salary_max, j.salary_type,
            <include refid="Job_Salary_Label_Expr" /> AS salary,
            j.link,
            j.content AS job_duties,
            j.requirements AS job_requirements,
            j.keywords AS job_keywords,
            c.industries AS company_industries, c.size AS company_size, c.type AS company_funding_type
        <include refid="Job_Company_From_Where" />
        ORDER BY j.updated_at DESC
    </select>
</mapper>
