<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zdmj.knowledgeService.mapper.KnowledgeVectorTaskMapper">
    <!--
      骨架文件：当前不定义自定义 SQL。
      后续如需复杂查询，可在此补充 select/insert/update/delete 语句。
    -->
    <!-- 根据知识库ID删除向量化任务 -->
    <delete id="deleteByKnowledgeId"> DELETE FROM knowledge_vector_tasks WHERE knowledge_id = #{knowledgeId} </delete>
</mapper>
