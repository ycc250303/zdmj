{
  "module": "conversationService",
  "pathCountMin": 6,
  "requiredPaths": [
    {
      "id": "REGISTER_HAPPY",
      "matchers": [
        "(?i).*ConversationServiceImplTest#createConversation.*"
      ]
    },
    {
      "id": "LOGIN_HAPPY",
      "matchers": [
        "(?i).*ConversationServiceImplTest#getById.*",
        "(?i).*MessageServiceImplTest#createStream.*"
      ]
    },
    {
      "id": "RESET_PASSWORD_HAPPY",
      "matchers": [
        "(?i).*MessageServiceImplTest#resumeStream.*"
      ]
    },
    {
      "id": "UPDATE_INFO_HAPPY",
      "matchers": [
        "(?i).*ConversationServiceImplTest#updateTitle.*",
        "(?i).*MessageServiceImplTest#getMessages.*"
      ]
    },
    {
      "id": "EXCEPTION_BAD_INPUT",
      "matchers": [
        "(?i).*ConversationServiceImplTest#.*(idNull|titleBlank).*",
        "(?i).*MessageServiceImplTest#.*(streamIdNull|accessFailed).*"
      ]
    },
    {
      "id": "EXCEPTION_NOT_FOUND_OR_AUTH",
      "matchers": [
        "(?i).*ConversationServiceImplTest#.*(noPermission|updateFailed|removeFailed|saveFailed).*",
        "(?i).*MessageServiceImplTest#.*(failed|saveFailed).*"
      ]
    }
  ]
}
