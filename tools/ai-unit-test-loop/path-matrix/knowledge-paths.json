{
  "module": "knowledgeService",
  "pathCountMin": 6,
  "requiredPaths": [
    {
      "id": "REGISTER_HAPPY",
      "matchers": [
        ".*submitVectorizeTaskCreateSuccess_shouldInsertPendingTask.*",
        ".*submitDeleteTaskCreateSuccess_shouldInsertPendingDeleteTask.*"
      ]
    },
    {
      "id": "LOGIN_HAPPY",
      "matchers": [
        ".*createSuccess_shouldSetPendingAndSubmitTask.*",
        ".*getByPageDefaultLimit_shouldNormalizeAndReturnPage.*"
      ]
    },
    {
      "id": "RESET_PASSWORD_HAPPY",
      "matchers": [
        ".*streamAnswerRagHit_shouldUseRagSystemPromptWithContext.*",
        ".*streamAnswerRewriteEnabled_shouldCallRewritePromptThenRag.*"
      ]
    },
    {
      "id": "UPDATE_INFO_HAPPY",
      "matchers": [
        ".*updateContentChanged_shouldSubmitTaskAndSetPending.*",
        ".*updateContentNoChange_shouldSkipEmbeddingTask.*"
      ]
    },
    {
      "id": "EXCEPTION_BAD_INPUT",
      "matchers": [
        ".*createInvalidUrl_shouldThrowUrlFormatError.*",
        ".*vectorizeAndStoreUnsupportedType_shouldThrowEmbeddingFailed.*"
      ]
    },
    {
      "id": "EXCEPTION_NOT_FOUND_OR_AUTH",
      "matchers": [
        ".*getByIdNotOwner_shouldThrowKnowledgeDocumentNotFound.*",
        ".*updateNotFound_shouldThrowKnowledgeDocumentNotFound.*",
        ".*vectorizeAndStoreNotFound_shouldThrowKnowledgeBaseNotFound.*"
      ]
    }
  ]
}
